# Игнорируем всё в wp-content
*

# Оставляем сам .gitignore
!.gitignore

# Оставляем каталоги тем и плагинов
!themes/
!plugins/

# Игнорируем остальные темы
themes/*

# Оставляем собственную тему
!themes/wh-tattoo/
!themes/wh-tattoo/**

# Игнорируем остальные плагины
plugins/*

# Оставляем собственный плагин
!plugins/wh-tattoo-tools/
!plugins/wh-tattoo-tools/**

# Собственный плагин отзывов
!plugins/wh-reviews/
!plugins/wh-reviews/**

# Локальный экспортёр отзывов, без результатов и окружения
!tools/
!tools/yandex-reviews-exporter/
!tools/yandex-reviews-exporter/export_reviews.py
!tools/yandex-reviews-exporter/requirements.txt
!tools/yandex-reviews-exporter/config.example.json
!tools/yandex-reviews-exporter/README.md
!tools/yandex-reviews-exporter/output/
!tools/yandex-reviews-exporter/output/.gitkeep

# Временные файлы
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# Редакторы
.vscode/
.idea/

# Зависимости, если появятся позднее
node_modules/
vendor/

# Секреты и локальные настройки
.env
.env.*
*.local

# Локальная конфигурация экспортёра отзывов
tools/yandex-reviews-exporter/config.json

# Диагностические результаты и экспорт отзывов
tools/yandex-reviews-exporter/output/*
!tools/yandex-reviews-exporter/output/.gitkeep

# Локальное Python-окружение
tools/yandex-reviews-exporter/.venv/
tools/yandex-reviews-exporter/__pycache__/